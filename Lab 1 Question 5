public class CalculatorMethod {
    public static void main(String[] args) {
    
    int equation1= square(add((multiply(3,4)),(multiply(5,7))));
    int equation2= add((square(add(4,7))),(square(add(8,3))));
    
    System.out.println("Result for equation 1 is: "+ equation1 );
    System.out.println("Result for equation 2 is: "+ equation2 );
    
    }
    
    public static int add(int a, int b)
    {
        return a+b;
    }
    
    public static int square(int a)
    {
        return a*a;
    }
    
    public static int multiply(int a, int b)
    {
        return a*b;
    }
}
